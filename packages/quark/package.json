{
  "name": "quark",
  "version": "0.1.0",
  "description": "Quark — AI coding agent CLI and terminal UI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "quark": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "preload.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "bun --preload ./preload.ts src/tui/index.tsx",
    "cli": "bun --preload ./preload.ts src/cli.ts"
  },
  "dependencies": {
    "@opentui/core": "0.1.86",
    "@opentui/solid": "0.1.86",
    "@quark/runner": "0.1.0",
    "ai": "^6.0.116",
    "marked": "^17.0.6",
    "solid-js": "1.9.9",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1"
  }
}
