{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    // Typecheck-only: resolve the engine's subpath exports back to source so a
    // clean checkout type-checks without building @quark/runner first (its
    // `exports` point at dist, which only exists after a build). Keep this in
    // sync with the runner exports map. scripts/build-package.ts keeps these
    // packages external so the aliases never affect the bundle.
    "paths": {
      "@quark/runner": ["../runner/src/index.ts"],
      "@quark/runner/*": ["../runner/src/*.ts"],
      "@quark/acp": ["../acp/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/tui/**"
  ]
}
