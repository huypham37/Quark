{
  "name": "@quark/acp",
  "version": "0.1.0",
  "description": "Agent Client Protocol (ACP) server for Quark — JSON-RPC 2.0 over NDJSON",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@quark/runner": "0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  }
}
