{
  "name": "quark-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Quark monorepo — @quark/runner engine + quark CLI/TUI",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/runner build && bun run --cwd packages/quark build",
    "typecheck": "bun run --cwd packages/runner typecheck && bun run --cwd packages/quark typecheck && tsc --project tsconfig.web.json --noEmit",
    "test": "bun test",
    "dev": "bun --preload ./packages/quark/preload.ts packages/quark/src/tui/index.tsx",
    "cli": "bun --preload ./packages/quark/preload.ts packages/quark/src/cli.ts",
    "web": "bun web/dev.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:serve": "bun web/server.ts",
    "docs": "typedoc"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.5",
    "vite-plugin-solid": "^2.11.8"
  }
}
