{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    // Typecheck-only: see tsconfig.web.json.
    "paths": {
      "@quark/runner": ["./packages/runner/src/index.ts"],
      "@quark/runner/*": ["./packages/runner/src/*.ts"]
    }
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "web/**/*.ts",
    "web/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "web/dist", "packages"]
}
