{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node", "bun"],
    "lib": ["ESNext"],
    "skipLibCheck": true
  },
  "include": ["index.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/tui/**/*",
    "src/web/client/**/*",
    "src/cli.ts",
    "test/**/*",
    "scripts/**/*",
    "examples/**/*"
  ]
}
